# Romanian Septica Backend - Environment Variables Configuration
# Copy this file to .env and update values for your environment
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your specific values
#   docker-compose up -d

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port the server listens on (default: 8082)
PORT=8082

# Environment mode: development, staging, production
# Controls logging verbosity and debug features
ENVIRONMENT=development

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# Full PostgreSQL connection string format:
# postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[disable|require]
#
# For docker-compose (services connect via internal network):
DATABASE_URL=postgresql://septica_user:septica_dev_password@postgres:5432/septica?sslmode=disable

# For local development (connecting to PostgreSQL on host machine):
# DATABASE_URL=postgresql://septica_user:septica_dev_password@localhost:5435/septica?sslmode=disable

# Database password (used by both PostgreSQL container and backend)
# SECURITY: Change this in production to a strong password
DB_PASSWORD=septica_dev_password

# ============================================================================
# AUTHENTICATION CONFIGURATION (JWT)
# ============================================================================

# JWT secret key for signing authentication tokens
# SECURITY: MUST be minimum 32 characters in production
# Generate with: openssl rand -base64 32
JWT_SECRET=dev_secret_change_in_production_minimum_32_chars

# JWT token expiration duration
# Format: Go duration string (e.g., 24h, 7d, 168h)
JWT_EXPIRATION=24h

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket read buffer size in bytes (default: 1024)
WS_READ_BUFFER_SIZE=1024

# WebSocket write buffer size in bytes (default: 1024)
WS_WRITE_BUFFER_SIZE=1024

# Maximum message size in bytes (default: 64KB)
WS_MESSAGE_LIMIT=65536

# ============================================================================
# GAME CONFIGURATION
# ============================================================================

# Maximum number of concurrent games the server can handle
MAX_CONCURRENT_GAMES=10000

# Total game timeout before automatic termination
# Format: Go duration string (e.g., 30m, 1h, 2h30m)
GAME_TIMEOUT=30m

# Timeout for individual player moves
MOVE_TIMEOUT=30s

# ============================================================================
# RATE LIMITING
# ============================================================================

# Maximum number of requests per time window
RATE_LIMIT_REQUESTS=120

# Time window for rate limiting
# Format: Go duration string (e.g., 1m, 60s)
RATE_LIMIT_WINDOW=1m

# ============================================================================
# LOGGING
# ============================================================================

# Log level: debug, info, warn, error, fatal
# Use 'debug' for development, 'info' for production
LOG_LEVEL=info

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend URL for CORS (comma-separated for multiple origins)
# Local development PWA
FRONTEND_URL=http://localhost:3000

# Additional allowed origins (if needed):
# FRONTEND_URL=http://localhost:3000,https://septica.example.com

# ============================================================================
# DATABASE MIGRATIONS
# ============================================================================

# Skip automatic database migrations on startup
# Set to 'true' only if you manage migrations manually
SKIP_MIGRATIONS=false

# ============================================================================
# REDIS CONFIGURATION (Optional - Currently Unused)
# ============================================================================

# Redis connection URL for future caching/session management
# Uncomment when Redis integration is implemented
# REDIS_URL=redis://redis:6379

# ============================================================================
# PRODUCTION SECURITY NOTES
# ============================================================================
#
# Before deploying to production:
#
# 1. DATABASE:
#    - Use strong, unique password for DB_PASSWORD
#    - Enable SSL/TLS: sslmode=require in DATABASE_URL
#    - Restrict database access to backend service only
#
# 2. AUTHENTICATION:
#    - Generate cryptographically secure JWT_SECRET (minimum 32 chars)
#    - Consider shorter JWT_EXPIRATION for sensitive environments
#    - Implement refresh token rotation
#
# 3. NETWORK:
#    - Use HTTPS/WSS for all external connections
#    - Configure firewall rules to restrict access
#    - Set FRONTEND_URL to your actual production domain
#
# 4. ENVIRONMENT:
#    - Set ENVIRONMENT=production
#    - Set LOG_LEVEL=info or warn (not debug)
#    - Never commit .env files to version control
#
# 5. MONITORING:
#    - Enable Prometheus metrics at /metrics endpoint
#    - Set up alerting for health check failures
#    - Monitor database connection pool and query performance
#
# ============================================================================
