#!/bin/bash
# Pre-commit Hook - Romanian Septica Backend
# Ensures code quality before commits
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== Pre-commit Checks ===${NC}"
echo ""

# Function to print check status
check_step() {
    local step_num=$1
    local step_name=$2
    echo -e "${BLUE}${step_num}. ${step_name}...${NC}"
}

# Function to print success
check_success() {
    echo -e "${GREEN}✓ $1${NC}"
    echo ""
}

# Function to print error and exit
check_error() {
    echo -e "${RED}✗ $1${NC}"
    echo ""
    exit 1
}

# 1. Check code formatting
check_step "1" "Checking code formatting"
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v vendor || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}The following files are not formatted:${NC}"
    echo "$UNFORMATTED"
    echo ""
    echo -e "${YELLOW}Run 'make format' or 'gofmt -w .' to fix${NC}"
    check_error "Code formatting check failed"
fi
check_success "Code formatting OK"

# 2. Run go vet
check_step "2" "Running go vet"
if ! go vet ./... 2>&1; then
    check_error "go vet failed"
fi
check_success "go vet OK"

# 3. Run go mod tidy check
check_step "3" "Checking go.mod and go.sum"
go mod tidy
if ! git diff --exit-code go.mod go.sum > /dev/null 2>&1; then
    echo -e "${YELLOW}go.mod or go.sum has changes${NC}"
    echo -e "${YELLOW}Run 'go mod tidy' and stage the changes${NC}"
    check_error "go.mod/go.sum check failed"
fi
check_success "go.mod and go.sum OK"

# 4. Run unit tests (skip integration tests for speed)
check_step "4" "Running unit tests"
if ! go test -short ./... 2>&1 | grep -E "PASS|FAIL|ok|SKIP"; then
    check_error "Unit tests failed"
fi
check_success "Unit tests OK"

# 5. Check for common issues
check_step "5" "Checking for common issues"

# Check for debugging statements
DEBUGGING=$(grep -r "fmt.Println\|log.Println\|panic" --include="*.go" --exclude-dir=vendor --exclude="*_test.go" . || true)
if [ -n "$DEBUGGING" ]; then
    echo -e "${YELLOW}Warning: Found debugging statements:${NC}"
    echo "$DEBUGGING"
    echo ""
    echo -e "${YELLOW}Consider removing or using proper logging${NC}"
fi

# Check for TODO comments
TODOS=$(grep -r "TODO\|FIXME\|XXX\|HACK" --include="*.go" --exclude-dir=vendor . || true)
if [ -n "$TODOS" ]; then
    echo -e "${YELLOW}Info: Found TODO/FIXME comments:${NC}"
    echo "$TODOS" | head -5
    if [ $(echo "$TODOS" | wc -l) -gt 5 ]; then
        echo "  ... and $(( $(echo "$TODOS" | wc -l) - 5 )) more"
    fi
    echo ""
fi

check_success "Common issues check complete"

# 6. Optional: Run linter if available
if command -v golangci-lint &> /dev/null; then
    check_step "6" "Running golangci-lint"
    if ! golangci-lint run --timeout=2m --fast 2>&1; then
        echo -e "${YELLOW}Linter found issues (not blocking)${NC}"
        echo ""
    else
        check_success "Linter OK"
    fi
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
